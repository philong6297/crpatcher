{
  "$defs": {
    "PatchFileOption": {
      "additionalProperties": false,
      "properties": {
        "ext": {
          "default": "patch",
          "pattern": "^\\w+$",
          "title": "Ext",
          "type": "string"
        },
        "encoding": {
          "default": "utf-8",
          "title": "Encoding",
          "type": "string"
        },
        "replacement_separator": {
          "default": "-",
          "pattern": "^[\\w-]+$",
          "title": "Replacement Separator",
          "type": "string"
        }
      },
      "title": "PatchFileOption",
      "type": "object"
    },
    "PatchInfoOption": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "encoding": {
          "default": "utf-8",
          "title": "Encoding",
          "type": "string"
        },
        "ext": {
          "default": "patchinfo",
          "pattern": "^\\w+$",
          "title": "Ext",
          "type": "string"
        }
      },
      "title": "PatchInfoOption",
      "type": "object"
    },
    "PatchRequest": {
      "additionalProperties": false,
      "properties": {
        "repo_dir": {
          "format": "path",
          "title": "Repo Dir",
          "type": "string"
        },
        "patch_dir": {
          "format": "path",
          "title": "Patch Dir",
          "type": "string"
        }
      },
      "required": [
        "repo_dir",
        "patch_dir"
      ],
      "title": "PatchRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "requests": {
      "items": {
        "$ref": "#/$defs/PatchRequest"
      },
      "title": "Repositories",
      "type": "array",
      "default": []
    },
    "patchinfo_file_opt": {
      "$ref": "#/$defs/PatchInfoOption",
      "default": {}
    },
    "patch_file_opt": {
      "$ref": "#/$defs/PatchFileOption",
      "default": {}
    }
  },
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "CRPatcherConfig",
  "type": "object"
}